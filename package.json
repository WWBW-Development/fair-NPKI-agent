{
  "name": "fair-npki-agent",
  "version": "1.0.0",
  "description": "NPKI Certificate Auto-Discovery Node.js Agent",
  "main": "dist/main.js",
  "license": "MIT",
  "bin": {
    "fair-npki-agent": "dist/main.js"
  },
  "scripts": {
    "type-check": "tsc",
    "start": "npm run type-check && node dist/main.js",
    "dev": "npm run type-check && node dist/main.js",
    "download:nssm": "./scripts/download-nssm.sh",
    "pack:mac": "npm run type-check && pkg . --targets node22-macos-x64 --output build/npki-agent-macos",
    "pack:win": "npm run type-check && pkg . --targets node22-win-x64 --output build/npki-agent-win.exe",
    "pack": "npm run type-check && pkg . --targets node22-macos-x64,node22-win-x64 --out-path build",
    "build:mac": "./build-pkg.sh",
    "build:win": "./build-win-binary.sh"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "pkg": {
    "scripts": "dist/**/*.js"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@yao-pkg/pkg": "^5.15.0",
    "prettier": "^3.8.1",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "form-data": "^4.0.0"
  }
}
