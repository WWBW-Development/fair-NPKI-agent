<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.wwbw.fair-npki-agent</string>
    <!-- 서비스의 고유 ID 역도메인 형식 권장 (com.회사명.앱명) launchctl에서 이 이름으로 서비스 제어 -->

    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/fair-npki-agent</string>
    </array>
    <!-- 실행할 프로그램의 경로 -->
    
    <key>RunAtLoad</key>
    <true/>
    <!-- 사용자 로그인 시 자동 시작. plist가 로드될 때 즉시 실행 -->
    
    <key>KeepAlive</key>
    <true/>
    <!-- 프로세스가 종료되면 자동으로 재시작 크래시 시 자동 복구 안정적인 백그라운드 실행 보장 -->
    
    <key>StandardOutPath</key>
    <string>/tmp/fair-npki-agent.log</string>
    <!-- 일반 로그 저장 위치 (console.log 출력) -->
    
    <key>StandardErrorPath</key>
    <string>/tmp/fair-npki-agent.error.log</string>
    <!-- 에러 로그 저장 위치 (console.error 출력) -->
    
    <key>WorkingDirectory</key>
    <string>/tmp</string>
    <!-- 프로그램 실행 시 작업 디렉토리 -->
</dict>
</plist>
